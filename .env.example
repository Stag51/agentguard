# Copy to .env and fill in. .env is gitignored; this example file is safe to commit.
GEMINI_API_KEY=

# Optional overrides
# AGENTGUARD_GEMINI_BASE=gemini-2.5-flash
# AGENTGUARD_GEMINI_CHEAP=gemini-2.5-flash-lite
# AGENTGUARD_DB=sqlite:///agentguard.db
# ANTHROPIC_API_KEY=

# Hosted Postgres (Neon / Supabase / Vercel Postgres). When set, runs are written there
# and the Vercel dashboard reads from the same database. Leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
